{
	"name": "Pure",
	"author": "Riguz Lee",
	"url": "https://github.com/drriguz/Pure",
	"descriptionmsg": "pure-desc",
	"namemsg": "skinname-pure",
	"license-name": "GPL-2.0+",
	"requires": {
		"MediaWiki": ">= 1.41.0"
	},
	"manifest_version": 2,
	"type": "skin",
	"ValidSkinNames": {
		"pure": {
			"class": "SkinTemplate",
			"args": [
				{
					"bodyClasses": [ "no-js" ],
					"bodyOnly": true,
					"template": "PureTemplate",
					"name": "pure",
					"responsive": true,
					"menus": [
						"associated-pages",
						"views",
						"actions",
						"user-menu",
						"notifications",
						"user-interface-preferences",
						"user-page"
					],
					"styles": [
						"skins.pure.styles"
					],
					"scripts": [
						"skins.pure.js"
					]
				}
			]
		}
	},
	"AutoloadClasses": {
        "PureTemplate": "Pure.template.php"
	},
	"MessagesDirs": {
		"FooBar": "i18n"
	},
	"ResourceModules": {
		"skins.pure.styles":  {
			"class": "MediaWiki\\ResourceLoader\\SkinModule",
			"features": {
				"interface": true,
				"interface-message-box": true,
				"interface-category": true
			},
			"styles": [
				"assets/css/bulma.min.css",
				"assets/font-awesome/css/font-awesome.min.css",
				"assets/css/pure.css",
				"assets/css/dracula.css"
			]
		},
		"skins.pure.js":  {
			"scripts": [
				"assets/js/init.js"
			],
			"dependencies": [
				"jquery.cookie"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "Pure"
	}
}
